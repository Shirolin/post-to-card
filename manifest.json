{
  "manifest_version": 3,
  "name": "Post-to-Card",
  "version": "1.0.0",
  "description": "Convert Twitter/X posts and threads into beautifully formatted, high-resolution shareable card images locally and offline.",
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": [
    "https://*.twimg.com/*",
    "https://pbs.twimg.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Post-to-Card"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["graphql-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
